{
  "name": "prosm-time",
  "productName": "PROSM Time",
  "private": true,
  "version": "2.3.5",
  "description": "PROSM Time - Enterprise Time, Attendance & Workforce Presence. Standalone product, managed by PROSM Management as its control plane. See docs/PROSM_TIME_IMPLEMENTATION_MASTER_FILE_V3.md.",
  "author": "PROSM",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:obfuscated": "tsc -b && vite build && node scripts/obfuscate.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^8.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@supabase/supabase-js": "^2.57.0",
    "@types/leaflet": "^1.9.22",
    "electron-serve": "^3.0.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "javascript-obfuscator": "^4.2.2",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "png-to-ico": "^3.0.2",
    "terser": "^5.51.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "net.prosm.time.desktop",
    "productName": "PROSM Time",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "PROSM-Time-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": false
  }
}
