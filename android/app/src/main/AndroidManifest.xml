<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Push notifications (owner 2026-10-20): the notification bar icon, its colour and
             the default channel for a message that names none. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_prosm" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/prosm_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="prosm-alerts" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owner 2026-11-12: an SOS rings with the alarm tone and opens on the whole screen, also with the
             app closed and the phone locked. The app's service takes the push plugin's place (it does all the
             plugin did, and shows the SOS itself); the SOS screen shows over the lock screen. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".SosMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".SosSilenceReceiver"
            android:exported="false" />
        <activity
            android:name=".SosAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="net.prosm.time.sos"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- v2.3.43 step 19 (item 12): the plugin declares its location service
             exported; only this app binds to it, so no other app may start it. -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- Owner 2026-11-11: the shift is followed by the app's own service, also after the app is
             closed (stopWithTask false); after a restart the person is asked to open the app. -->
        <service
            android:name=".ShiftTrackingService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <receiver
            android:name=".ShiftTrackingBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions - this app's own real workflows use these directly
         (navigator.geolocation for clock-in/out, getUserMedia for
         attendance evidence photos, CameraCaptureModal.tsx) -
         Capacitor's bridge WebChromeClient prompts for these at
         runtime automatically once declared here. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- PROSM Connect (owner 2026-11-13): voice messages and calls - asked only when the person first presses the microphone or answers -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- step 19: a phone without GPS can still install the app (location then comes
         from the network, and clock-in explains when none is available). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" tools:replace="android:required" />

    <!-- Shift presence tracking (@capacitor-community/background-geolocation)
         runs only while someone is clocked in at a monitored site, as a
         foreground service of type location with a visible, ongoing
         notification - started from the app on screen, so Android's
         "while using the app" location permission covers it, also with the
         screen locked. Owner 2026-10-28: the app never asks for "Allow all
         the time", so ACCESS_BACKGROUND_LOCATION is removed (also from any
         library) and Google Play reviews no background-location use.
         FOREGROUND_SERVICE_LOCATION and POST_NOTIFICATIONS keep the service
         and its notification (Android 14 / 13). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Owner 2026-11-12: the SOS opens on the whole screen over the lock screen (SosAlarmActivity) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- step 19 (item 12): the radio's background service plays media (patched
         plugin, see DECISIONS D-12); nothing asks to skip battery optimisation. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
</manifest>
