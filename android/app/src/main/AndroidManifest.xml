<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions - this app's own real workflows use these directly
         (navigator.geolocation for clock-in/out, getUserMedia for
         attendance evidence photos, CameraCaptureModal.tsx) -
         Capacitor's bridge WebChromeClient prompts for these at
         runtime automatically once declared here. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- § user-directed, 2026-09-13 - real geofence-exit tracking must
         keep working even while the app is backgrounded (screen
         locked, another app in front), not just while this app's own
         screen is on top - @capacitor-community/background-geolocation
         drives this, only ever active while a real presence session
         is open (clocked in at a monitored site), and only ever with
         the user's own explicit consent via the plugin's own
         permission dialogs. ACCESS_BACKGROUND_LOCATION is Android's
         own separate "Allow all the time" consent step (distinct from
         the foreground ACCESS_FINE_LOCATION above); FOREGROUND_SERVICE/
         FOREGROUND_SERVICE_LOCATION and POST_NOTIFICATIONS are what let
         Android keep the tracking alive with a real, visible, always-
         cancellable notification while backgrounded - required as of
         Android 14/13 respectively, and Google Play's own review
         requires this exact "visible ongoing notification" pattern for
         any app requesting background location. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
