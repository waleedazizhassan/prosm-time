<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Push notifications (owner 2026-10-20): the notification bar icon, its colour and
             the default channel for a message that names none. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_prosm" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/prosm_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="prosm-alerts" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v2.3.43 step 19 (item 12): the plugin declares its location service
             exported; only this app binds to it, so no other app may start it. -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:replace="android:exported" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions - this app's own real workflows use these directly
         (navigator.geolocation for clock-in/out, getUserMedia for
         attendance evidence photos, CameraCaptureModal.tsx) -
         Capacitor's bridge WebChromeClient prompts for these at
         runtime automatically once declared here. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- step 19: a phone without GPS can still install the app (location then comes
         from the network, and clock-in explains when none is available). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" tools:replace="android:required" />

    <!-- § user-directed, 2026-09-13 - real geofence-exit tracking must
         keep working even while the app is backgrounded (screen
         locked, another app in front), not just while this app's own
         screen is on top - @capacitor-community/background-geolocation
         drives this, only ever active while a real presence session
         is open (clocked in at a monitored site), and only ever with
         the user's own explicit consent via the plugin's own
         permission dialogs. ACCESS_BACKGROUND_LOCATION is Android's
         own separate "Allow all the time" consent step (distinct from
         the foreground ACCESS_FINE_LOCATION above); FOREGROUND_SERVICE/
         FOREGROUND_SERVICE_LOCATION and POST_NOTIFICATIONS are what let
         Android keep the tracking alive with a real, visible, always-
         cancellable notification while backgrounded - required as of
         Android 14/13 respectively, and Google Play's own review
         requires this exact "visible ongoing notification" pattern for
         any app requesting background location. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- step 19 (item 12): the radio's background service plays media (patched
         plugin, see DECISIONS D-12); nothing asks to skip battery optimisation. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
</manifest>
